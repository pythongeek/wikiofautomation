{
  "name": "wikiofautomation-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "description": "wiki of automation — encyclopedia + marketplace + newsroom for the automation economy",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build && node -e \"fs.cpSync('dist/client','dist',{recursive:true})\"",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "embed": "tsx scripts/embed-vault.ts",
    "seed-admin": "tsx scripts/seed-admin.ts",
    "start": "node index.js",
    "postinstall": "npm rebuild better-sqlite3 @node-rs/argon2 || true"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@node-rs/argon2": "^2.0.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.4.4",
    "astro-pagefind": "^1.8.6",
    "better-sqlite3": "^13.0.3",
    "cytoscape": "^3.34.0",
    "cytoscape-cola": "^2.5.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^13.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^5.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "astro": "^7.4.4",
    "@astrojs/node": "^11.1.9",
    "vite": "^8.3.5",
    "sharp": "^0.35.5",
    "shell-quote": "^1.12.0",
    "zod": "^4.6.7",
    "devalue": "^5.9.3",
    "fast-uri": "^3.1.9",
    "source-map-js": "^1.2.2",
    "js-yaml": "^4.3.2",
    "svgo": "^4.1.0",
    "esbuild": "^0.28.2",
    "drizzle-orm": "^0.45.4",
    "smol-toml": "^1.9.1",
    "nanoid": "^3.3.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
