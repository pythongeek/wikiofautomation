{
  "name": "wikiofautomation-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "description": "wiki of automation — encyclopedia + marketplace + newsroom for the automation economy",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build && node -e \"fs.cpSync('dist/client','dist',{recursive:true})\"",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "embed": "tsx scripts/embed-vault.ts",
    "seed-admin": "tsx scripts/seed-admin.ts",
    "start": "node index.js",
    "postinstall": "npm rebuild better-sqlite3 @node-rs/argon2"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.0.1",
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.2.1",
    "@node-rs/argon2": "^2.0.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^5.0.0",
    "astro-pagefind": "^1.8.6",
    "better-sqlite3": "^11.7.0",
    "cytoscape": "^3.34.0",
    "cytoscape-cola": "^2.5.1",
    "drizzle-orm": "^0.38.2",
    "framer-motion": "^13.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^5.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "tsx": "4.20.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
