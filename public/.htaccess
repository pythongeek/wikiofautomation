# Hostinger Apache Static Routing for Wiki of Automation (Astro Static Site)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Serve physical files directly if they exist
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. Append .html if extension is missing and matching file exists
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ /$1.html [L]

    # 3. Serve subfolder index.html if folder exists
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ /$1/index.html [L]

    # 4. Fallback to 404 page for missing routes
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{DOCUMENT_ROOT}/404/index.html -f
    RewriteRule ^(.*)$ /404/index.html [L]
</IfModule>
