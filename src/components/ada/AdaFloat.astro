---
/**
 * AdaFloat.astro — Floating Cyber-Industrial AI Assistant Widget
 * Source: Google Stitch Master Page Specification (SCREEN_4)
 */
---

<div class="fixed right-6 bottom-6 z-50 flex flex-col items-end" id="ask-ada-widget">
  <!-- Expanded Chat Modal Panel -->
  <div id="ada-chat-panel" class="hidden glass-panel bg-[#131317]/90 backdrop-blur-2xl border border-white/10 rounded-2xl w-[360px] sm:w-[380px] h-[500px] mb-4 flex-col overflow-hidden shadow-[0_0_30px_rgba(192,245,0,0.2)] transition-all duration-300">
    <!-- Header -->
    <div class="flex items-center justify-between p-4 border-b border-white/5 bg-[#0D0D14]/90">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-[#1f1f23] flex items-center justify-center relative border border-white/10">
          <span class="material-symbols-outlined text-[#c0f500] text-sm" style="font-variation-settings: 'FILL' 1;">smart_toy</span>
          <div class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-[#c0f500] shadow-[0_0_8px_#c0f500]"></div>
        </div>
        <div>
          <div class="font-sans text-sm font-semibold text-white">Ada</div>
          <div class="font-mono text-[10px] text-[#c4caac]">Wiki of Automation AI</div>
        </div>
      </div>
      <button id="close-chat-btn" class="w-8 h-8 rounded-full hover:bg-white/10 flex items-center justify-center transition-colors text-[#9ca3af] hover:text-white cursor-pointer border-none bg-transparent">
        <span class="material-symbols-outlined text-sm">close</span>
      </button>
    </div>

    <!-- Messages Container -->
    <div class="flex-grow p-4 overflow-y-auto flex flex-col gap-3.5 font-sans text-sm chat-messages" id="ada-chat-messages">
      <div class="flex gap-2.5 max-w-[90%]">
        <div class="w-6 h-6 rounded-full bg-[#1f1f23] flex-shrink-0 flex items-center justify-center mt-1 border border-white/5">
          <span class="material-symbols-outlined text-[#c0f500] text-[12px]" style="font-variation-settings: 'FILL' 1;">smart_toy</span>
        </div>
        <div class="bg-white/5 rounded-2xl rounded-tl-sm p-3 border border-white/5 text-white leading-relaxed">
          Hello! I'm Ada, the Wiki of Automation AI assistant. How can I help you navigate the encyclopedia today?
        </div>
      </div>
    </div>

    <!-- Input Bar -->
    <div class="p-3 border-t border-white/5 bg-[#0D0D14]/95">
      <div class="relative flex items-center">
        <input
          id="ada-chat-input"
          type="text"
          class="w-full bg-[#050508] border border-white/10 rounded-lg py-2.5 pl-3.5 pr-11 font-sans text-sm text-white focus:outline-none focus:border-[#00e3fd] focus:ring-1 focus:ring-[#00e3fd] transition-all placeholder-[#9ca3af]/50"
          placeholder="Ask Ada anything..."
          autocomplete="off"
        />
        <button id="ada-chat-send" class="absolute right-1.5 w-7 h-7 rounded-md bg-[#c0f500] text-[#050508] flex items-center justify-center hover:brightness-110 transition-all cursor-pointer border-none">
          <span class="material-symbols-outlined text-xs font-bold" style="font-variation-settings: 'FILL' 1;">send</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Floating Toggle Button -->
  <button
    id="ada-toggle-btn"
    class="w-14 h-14 rounded-full bg-[#c0f500] text-[#050508] flex items-center justify-center shadow-[0_0_20px_rgba(192,245,0,0.4)] hover:scale-105 transition-transform duration-300 relative cursor-pointer border-none"
    aria-label="Ask Ada AI Assistant"
  >
    <span class="material-symbols-outlined text-2xl font-bold" style="font-variation-settings: 'FILL' 1;">electric_bolt</span>
  </button>
</div>

<script>
(() => {
  function initAdaWidget() {
    const toggleBtn = document.getElementById('ada-toggle-btn');
    const closeBtn = document.getElementById('close-chat-btn');
    const chatPanel = document.getElementById('ada-chat-panel');
    const chatInput = document.getElementById('ada-chat-input') as HTMLInputElement | null;
    const chatSend = document.getElementById('ada-chat-send');
    const messages = document.getElementById('ada-chat-messages');

    if (!toggleBtn || !closeBtn || !chatPanel || !chatInput || !chatSend || !messages) return;

    let isExpanded = false;

    function toggleChat() {
      isExpanded = !isExpanded;
      if (isExpanded) {
        chatPanel?.classList.remove('hidden');
        chatPanel?.classList.add('flex');
        chatInput?.focus();
      } else {
        chatPanel?.classList.add('hidden');
        chatPanel?.classList.remove('flex');
      }
    }

    toggleBtn.addEventListener('click', toggleChat);
    closeBtn.addEventListener('click', toggleChat);

    async function sendMsg() {
      const q = (chatInput?.value || '').trim();
      if (!q) return;

      // Append user msg
      const userBubble = document.createElement('div');
      userBubble.className = 'flex gap-2.5 max-w-[90%] self-end flex-row-reverse';
      userBubble.innerHTML = `<div class="bg-[#c0f500]/10 rounded-2xl rounded-tr-sm p-3 border border-[#c0f500]/20 text-[#c0f500] leading-relaxed">${escapeHtml(q)}</div>`;
      messages?.appendChild(userBubble);
      if (chatInput) chatInput.value = '';
      messages?.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });

      // Thinking indicator
      const thinkingBubble = document.createElement('div');
      thinkingBubble.className = 'flex gap-2.5 max-w-[90%]';
      thinkingBubble.innerHTML = `<div class="w-6 h-6 rounded-full bg-[#1f1f23] flex-shrink-0 flex items-center justify-center mt-1 border border-white/5"><span class="material-symbols-outlined text-[#c0f500] text-[12px]">smart_toy</span></div><div class="bg-white/5 rounded-2xl rounded-tl-sm p-3 border border-white/5 text-[#9ca3af] animate-pulse">Ada is searching the wiki...</div>`;
      messages?.appendChild(thinkingBubble);
      messages?.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });

      try {
        const res = await fetch('/api/ada', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ message: q }),
        });
        const data = res.ok ? await res.json() : null;
        thinkingBubble.remove();

        const botMsg = data?.reply || `Here are top resources for "${q}":`;
        const botBubble = document.createElement('div');
        botBubble.className = 'flex gap-2.5 max-w-[90%]';
        botBubble.innerHTML = `<div class="w-6 h-6 rounded-full bg-[#1f1f23] flex-shrink-0 flex items-center justify-center mt-1 border border-white/5"><span class="material-symbols-outlined text-[#c0f500] text-[12px]" style="font-variation-settings: 'FILL' 1;">smart_toy</span></div><div class="bg-white/5 rounded-2xl rounded-tl-sm p-3 border border-white/5 text-white leading-relaxed">${escapeHtml(botMsg)}</div>`;
        messages?.appendChild(botBubble);
        messages?.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
      } catch {
        thinkingBubble.remove();
        const errBubble = document.createElement('div');
        errBubble.className = 'flex gap-2.5 max-w-[90%]';
        errBubble.innerHTML = `<div class="w-6 h-6 rounded-full bg-[#1f1f23] flex-shrink-0 flex items-center justify-center mt-1 border border-white/5"><span class="material-symbols-outlined text-[#c0f500] text-[12px]">smart_toy</span></div><div class="bg-white/5 rounded-2xl rounded-tl-sm p-3 border border-white/5 text-white leading-relaxed">Ada is ready! Search wiki entries or explore listings.</div>`;
        messages?.appendChild(errBubble);
      }
    }

    function escapeHtml(s: string) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    chatSend.addEventListener('click', sendMsg);
    chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') sendMsg();
    });
  }

  document.addEventListener('astro:page-load', initAdaWidget);
  initAdaWidget();
})();
</script>
