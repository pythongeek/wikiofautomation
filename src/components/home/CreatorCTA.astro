---
/**
 * CreatorCTA.astro — Creator Monetization Band
 * Source: Google Stitch Master Page Specification (SCREEN_8)
 */
---

<section class="max-w-[1280px] mx-auto px-6 pb-24 relative z-10">
  <div class="relative overflow-hidden bg-gradient-to-br from-[#0D0D14] to-[#13131F] rounded-3xl border border-white/10 shadow-[0_0_30px_rgba(192,245,0,0.15)] p-8 md:p-12">
    <!-- Particle dots -->
    <div class="particle absolute w-1.5 h-1.5 bg-[#c0f500] rounded-full opacity-40 top-8 left-12 animate-pulse"></div>
    <div class="particle absolute w-1.5 h-1.5 bg-[#00e3fd] rounded-full opacity-40 top-2/3 left-1/2 animate-ping"></div>
    <div class="particle absolute w-1.5 h-1.5 bg-[#7b61ff] rounded-full opacity-40 top-1/3 right-16 animate-pulse"></div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <span class="font-mono text-xs text-[#c0f500] uppercase tracking-widest mb-3 block font-bold">FOR CREATORS</span>
        <h2 class="font-sans text-3xl sm:text-4xl text-white font-bold leading-tight mb-4">Publish once.<br>Earn while you sleep.</h2>
        <p class="font-sans text-sm sm:text-base text-[#9CA3AF] mb-6 max-w-lg leading-relaxed">
          Monetize your automation scripts, AI prompts, and workflows. Join the network of top-tier engineers building the decentralized intelligence marketplace.
        </p>

        <ul class="flex flex-col gap-3 mb-8 list-none p-0">
          <li class="flex items-center gap-3 font-sans text-sm sm:text-base text-white">
            <span class="material-symbols-outlined text-[#c0f500] text-lg" style="font-variation-settings: 'FILL' 1;">check_circle</span>
            Keep 90% of your revenue
          </li>
          <li class="flex items-center gap-3 font-sans text-sm sm:text-base text-white">
            <span class="material-symbols-outlined text-[#c0f500] text-lg" style="font-variation-settings: 'FILL' 1;">check_circle</span>
            Publish via Web, CLI, or API
          </li>
          <li class="flex items-center gap-3 font-sans text-sm sm:text-base text-white">
            <span class="material-symbols-outlined text-[#c0f500] text-lg" style="font-variation-settings: 'FILL' 1;">check_circle</span>
            Real-time performance analytics
          </li>
        </ul>

        <a href="/marketplace/publish" class="bg-[#c0f500] text-[#050508] rounded-full px-6 py-3 font-sans text-base font-semibold hover:shadow-[0_0_30px_rgba(192,245,0,0.6)] hover:-translate-y-0.5 transition-all duration-300 inline-block no-underline">
          Start publishing →
        </a>
      </div>

      <!-- 90% Revenue Circle Ring -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center pt-6 lg:pt-0">
        <div class="relative w-56 h-56 mb-6">
          <div class="absolute inset-0 rounded-full border-[14px] border-[#1f1f23]"></div>
          <div class="absolute inset-0 rounded-full border-[14px] border-transparent border-t-[#c0f500] border-r-[#7B61FF] rotate-45 opacity-90"></div>
          <div class="absolute inset-0 flex items-center justify-center flex-col">
            <span class="font-mono text-5xl font-bold text-[#c0f500]">90%</span>
            <span class="font-mono text-xs text-[#c4caac] uppercase mt-1 tracking-wider">Revenue Share</span>
          </div>
        </div>

        <div class="flex gap-4 w-full max-w-sm">
          <div class="flex-1 bg-[#2a292e]/50 border border-white/5 rounded-xl p-3.5 text-center backdrop-blur-sm">
            <span class="block font-mono text-[#c0f500] font-bold text-base mb-0.5">$0</span>
            <span class="font-sans text-xs text-[#c4caac]">to get started</span>
          </div>
          <div class="flex-1 bg-[#2a292e]/50 border border-white/5 rounded-xl p-3.5 text-center backdrop-blur-sm">
            <span class="block font-mono text-[#c0f500] font-bold text-base mb-0.5">1 min</span>
            <span class="font-sans text-xs text-[#c4caac]">to publish</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
