---
/**
 * Pillars.astro — Three Feature Cards (Learn / Get / Know)
 * Source: Google Stitch Master Page Specification (SCREEN_15)
 */
import { getCollection } from 'astro:content';

const [wiki, mkt, news] = await Promise.all([
  getCollection('wiki').catch(() => []),
  getCollection('marketplace', e => e.data.status === 'live').catch(() => []),
  getCollection('news').catch(() => []),
]);

const wikiCount = wiki.length || 2;
const mktCount = mkt.length || 1;
const newsCount = news.length || 1;
---

<section class="max-w-[1280px] mx-auto w-full px-6 pb-24 relative z-10">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Card 1: Wiki -->
    <a href="/wiki" class="group bg-[#13131F] border border-white/5 rounded-2xl p-6 min-h-[220px] flex flex-col transition-all duration-300 hover:-translate-y-1 hover:border-[#c0f500] hover:shadow-[0_0_20px_rgba(192,245,0,0.2)] no-underline cursor-pointer relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#c0f500]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <div class="flex justify-between items-center mb-5 relative z-10">
        <span class="text-[11px] text-[#4B5563] font-mono uppercase">01 — LEARN</span>
        <span class="bg-[#c0f500]/10 text-[#c0f500] text-[11px] font-mono rounded-full px-2.5 py-0.5 border border-[#c0f500]/20">{wikiCount} entries</span>
      </div>
      <h3 class="text-[20px] font-semibold text-white mb-2 relative z-10 font-sans">The Wiki</h3>
      <p class="text-[14px] text-[#9CA3AF] font-sans leading-relaxed flex-grow relative z-10">
        Wikipedia-style reference entries on every agent, framework, protocol, and model — neutral, sourced, always current.
      </p>
      <div class="flex items-center text-[14px] font-medium text-[#c0f500] font-sans mt-4 relative z-10">
        Browse the wiki
        <span class="material-symbols-outlined text-[18px] ml-1 transition-transform duration-300 group-hover:translate-x-1">arrow_forward</span>
      </div>
    </a>

    <!-- Card 2: Marketplace -->
    <a href="/marketplace" class="group bg-[#13131F] border border-white/5 rounded-2xl p-6 min-h-[220px] flex flex-col transition-all duration-300 hover:-translate-y-1 hover:border-[#00E5FF] hover:shadow-[0_0_20px_rgba(0,229,255,0.2)] no-underline cursor-pointer relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#00E5FF]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <div class="flex justify-between items-center mb-5 relative z-10">
        <span class="text-[11px] text-[#4B5563] font-mono uppercase">02 — GET</span>
        <span class="bg-[#00E5FF]/10 text-[#00E5FF] text-[11px] font-mono rounded-full px-2.5 py-0.5 border border-[#00E5FF]/20">{mktCount} live listings</span>
      </div>
      <h3 class="text-[20px] font-semibold text-white mb-2 relative z-10 font-sans">The Marketplace</h3>
      <p class="text-[14px] text-[#9CA3AF] font-sans leading-relaxed flex-grow relative z-10">
        Free and paid agents, n8n workflows, AI OS stacks, and hosted mini apps. Try before you install.
      </p>
      <div class="flex items-center text-[14px] font-medium text-[#00E5FF] font-sans mt-4 relative z-10">
        Explore listings
        <span class="material-symbols-outlined text-[18px] ml-1 transition-transform duration-300 group-hover:translate-x-1">arrow_forward</span>
      </div>
    </a>

    <!-- Card 3: Newsroom -->
    <a href="/news" class="group bg-[#13131F] border border-white/5 rounded-2xl p-6 min-h-[220px] flex flex-col transition-all duration-300 hover:-translate-y-1 hover:border-[#7B61FF] hover:shadow-[0_0_20px_rgba(123,97,255,0.2)] no-underline cursor-pointer relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#7B61FF]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <div class="flex justify-between items-center mb-5 relative z-10">
        <span class="text-[11px] text-[#4B5563] font-mono uppercase">03 — KNOW</span>
        <span class="bg-[#7B61FF]/10 text-[#7B61FF] text-[11px] font-mono rounded-full px-2.5 py-0.5 border border-[#7B61FF]/20">{newsCount} posts</span>
      </div>
      <h3 class="text-[20px] font-semibold text-white mb-2 relative z-10 font-sans">The Newsroom</h3>
      <p class="text-[14px] text-[#9CA3AF] font-sans leading-relaxed flex-grow relative z-10">
        Daily launches, deep dives, and benchmark leaderboards from across the automation industry.
      </p>
      <div class="flex items-center text-[14px] font-medium text-[#7B61FF] font-sans mt-4 relative z-10">
        Read today's news
        <span class="material-symbols-outlined text-[18px] ml-1 transition-transform duration-300 group-hover:translate-x-1">arrow_forward</span>
      </div>
    </a>
  </div>
</section>
