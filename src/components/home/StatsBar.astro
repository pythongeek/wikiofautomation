---
/**
 * StatsBar.astro — Cyber-Industrial Live Stats Section
 * Source: Google Stitch Master Page Specification
 */
import { getCollection } from 'astro:content';

const wiki = await getCollection('wiki').catch(() => []);
const mkt = await getCollection('marketplace', e => e.data.status === 'live').catch(() => []);

const wikiCount = wiki.length || 2;
const mktCount = mkt.length || 1;
---

<section class="max-w-[1000px] mx-auto w-full px-6 py-16 relative z-10">
  <div class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-white/5 border-y md:border-y-0 border-white/5">
    <div class="flex flex-col items-center justify-center p-6 text-center">
      <span class="text-[44px] md:text-[48px] font-bold text-white font-mono leading-none mb-2" data-target={wikiCount}>{wikiCount}</span>
      <span class="text-[11px] uppercase tracking-[0.1em] text-[#4B5563] font-mono">WIKI ENTRIES</span>
    </div>
    <div class="flex flex-col items-center justify-center p-6 text-center">
      <span class="text-[44px] md:text-[48px] font-bold text-white font-mono leading-none mb-2" data-target={mktCount}>{mktCount}</span>
      <span class="text-[11px] uppercase tracking-[0.1em] text-[#4B5563] font-mono">MARKETPLACE TOOLS</span>
    </div>
    <div class="flex flex-col items-center justify-center p-6 text-center">
      <span class="text-[44px] md:text-[48px] font-bold text-white font-mono leading-none mb-2">14,382</span>
      <span class="text-[11px] uppercase tracking-[0.1em] text-[#4B5563] font-mono">TOOLS INDEXED</span>
    </div>
    <div class="flex flex-col items-center justify-center p-6 text-center">
      <div class="flex items-baseline gap-2 mb-2">
        <span class="text-[15px] text-[#c4caac] font-sans">up to</span>
        <span class="text-[44px] md:text-[48px] font-bold text-[#c0f500] font-mono leading-none">94%</span>
      </div>
      <span class="text-[11px] uppercase tracking-[0.1em] text-[#4B5563] font-mono">CREATOR REVENUE</span>
    </div>
  </div>
</section>
