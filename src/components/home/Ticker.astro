---
/**
 * Ticker.astro — Live Marquee Activity Ticker
 * Source: Google Stitch Master Page Specification (SCREEN_15)
 */
---

<section class="w-full bg-[#0D0D14] border-y border-white/5 py-3 relative z-10 overflow-hidden">
  <div class="marquee-container font-mono text-[13px] text-[#9CA3AF]">
    <div class="marquee-content gap-12 px-6 items-center flex">
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500] animate-pulse"></span><span class="text-[#c0f500] font-semibold">12</span> new agents published today</span>
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500]"></span><span class="text-white font-semibold">340</span> workflows installed this week</span>
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500]"></span>wiki entry updated: <span class="text-white font-medium">Claude Sonnet 5</span></span>
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500]"></span><span class="text-[#c0f500] font-semibold">1,204</span> active builders online now</span>
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500]"></span>new comparison: <span class="text-white font-medium">n8n vs Make</span></span>
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500]"></span>trending workflow: <span class="text-white font-medium">auto-reply DM triage</span></span>
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500]"></span><span class="text-[#c0f500] font-semibold">42</span> new jobs posted</span>

      <!-- Duplicated for smooth loop -->
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500] animate-pulse"></span><span class="text-[#c0f500] font-semibold">12</span> new agents published today</span>
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500]"></span><span class="text-white font-semibold">340</span> workflows installed this week</span>
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500]"></span>wiki entry updated: <span class="text-white font-medium">Claude Sonnet 5</span></span>
      <span class="text-[#4B5563]">/</span>
      <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#c0f500]"></span><span class="text-[#c0f500] font-semibold">1,204</span> active builders online now</span>
    </div>
  </div>
</section>

<style>
  .marquee-container {
    overflow: hidden;
    white-space: nowrap;
    display: flex;
  }
  .marquee-content {
    display: flex;
    animation: marquee 30s linear infinite;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
