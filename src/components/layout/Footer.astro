---
/**
 * Footer.astro — Cyber-Industrial 5-Column Footer
 * Source: Google Stitch Master Page Specification (SCREEN_4)
 */
import Logo from '~/components/brand/Logo.astro';
const year = new Date().getFullYear();
---

<footer class="bg-[#0e0e12] border-t border-white/5 pt-16 pb-8 px-6 mt-20 relative z-10">
  <div class="max-w-[1280px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12 mb-14">
      <div class="lg:col-span-4 flex flex-col gap-5">
        <a href="/" class="flex items-center gap-2 text-lg font-bold text-white tracking-tight no-underline">
          <Logo size={24} />
          <span>wiki <span class="text-[#c4caac] font-normal">of</span> <span class="text-[#c0f500]">automation</span></span>
        </a>
        <p class="font-sans text-sm text-[#9CA3AF] max-w-sm leading-relaxed">
          The encyclopedia of automation — understand it, find it, ship it.
        </p>
        <div class="font-mono text-xs text-[#9CA3AF]/60 mt-auto pt-4">
          © {year} Wiki of Automation
        </div>
      </div>

      <div class="lg:col-span-2">
        <h4 class="font-mono text-xs text-white mb-5 tracking-widest uppercase font-bold">AI & Compute</h4>
        <ul class="flex flex-col gap-3 font-sans text-sm text-[#9CA3AF] list-none p-0">
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/notebooks">Kaggle & Colab</a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/local-ai">Local AI Free Methods</a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/models/finetuned">Fine-Tuned Models</a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/wiki">Automation Wiki</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h4 class="font-mono text-xs text-white mb-5 tracking-widest uppercase font-bold">Marketplace</h4>
        <ul class="flex flex-col gap-3 font-sans text-sm text-[#9CA3AF] list-none p-0">
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/marketplace/enterprise-workflows">150+ Node Workflows</a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/marketplace/plugins">WP & MCP Plugins</a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/marketplace/notebook-kits">Colab/Kaggle Kits</a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/marketplace/turnkey-games">Turnkey Games</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h4 class="font-mono text-xs text-white mb-5 tracking-widest uppercase font-bold">Company</h4>
        <ul class="flex flex-col gap-3 font-sans text-sm text-[#9CA3AF] list-none p-0">
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/about">About</a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/newsletter">Newsletter</a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline flex items-center gap-2" href="/jobs">Jobs <span class="font-mono text-[10px] bg-white/5 px-2 py-0.5 rounded border border-white/10 uppercase text-[#c0f500]">Hiring</span></a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/changelog">Changelog</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h4 class="font-mono text-xs text-white mb-5 tracking-widest uppercase font-bold">Language</h4>
        <ul class="flex flex-col gap-3 font-sans text-sm text-[#9CA3AF] list-none p-0">
          <li><a class="text-[#c0f500] hover:text-[#a8d700] transition-colors flex items-center gap-2 no-underline" href="/">
            <span class="material-symbols-outlined text-base">language</span>
            English
          </a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/bn/">বাংলা</a></li>
          <li><a class="hover:text-[#c0f500] transition-colors no-underline" href="/hi/">हिन्दी</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/5 pt-6 flex justify-between items-center text-xs font-mono text-[#4B5563]">
      <span>Built for the Automation Economy</span>
      <span>Made with ❤ in Bangladesh</span>
    </div>
  </div>
</footer>
