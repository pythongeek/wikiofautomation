---
/**
 * MarketplaceRow.astro — Cyber Marketplace Showcase
 * Source: Google Stitch Master Page Specification (SCREEN_14)
 */
import { getCollection, type CollectionEntry } from 'astro:content';

type Listing = CollectionEntry<'marketplace'>;

const all = await getCollection('marketplace', (e: Listing) => e.data.status === 'live').catch(() => [] as Listing[]);
const top = all.sort((a, b) => b.data.uses - a.data.uses).slice(0, 8);

const defaultItems = [
  {
    title: 'Inbox Triage Agent',
    type: 'agent',
    pricing: 'FREE',
    rating: '4.8',
    uses: '3.1k',
    icon: 'mail',
    slug: 'inbox-triage-agent',
    summary: 'Automated email triage and auto-reply assistant.'
  },
  {
    title: 'Omni-Ingestion Node',
    type: 'workflow',
    pricing: '0.05 SOL/mo',
    rating: '4.9',
    uses: '1.2k',
    icon: 'hub',
    slug: 'omni-ingestion-node',
    summary: 'Multi-source document and API data ingestion workflow.'
  },
  {
    title: 'Recursive Actor Framework',
    type: 'ai-os',
    pricing: 'FREE',
    rating: '4.7',
    uses: '800',
    icon: 'memory',
    slug: 'recursive-actor',
    summary: 'Autonomous recursive task planner and execution stack.'
  },
  {
    title: 'Lead Gen Assistant',
    type: 'app',
    pricing: '2 SOL',
    rating: '4.6',
    uses: '2.4k',
    icon: 'person_search',
    slug: 'lead-gen-assistant',
    summary: 'High-converting B2B prospect researcher and outreach bot.'
  }
];

const itemsToRender = top.length > 0 ? top.map(item => ({
  title: item.data.title,
  type: item.data.type,
  pricing: item.data.pricing.toUpperCase(),
  rating: item.data.rating.toFixed(1),
  uses: item.data.uses >= 1000 ? `${(item.data.uses / 1000).toFixed(1)}k` : `${item.data.uses}`,
  icon: item.data.type === 'agent' ? 'smart_toy' : item.data.type === 'workflow' ? 'hub' : 'memory',
  slug: item.slug,
  summary: item.data.summary || ''
})) : defaultItems;

const tabs = ['ALL', 'Agents', 'Workflows', 'AI OS', 'Apps'];
---

<section class="max-w-[1280px] mx-auto px-6 py-20 relative z-10" id="marketplace">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
    <div>
      <h2 class="text-3xl font-bold text-white mb-2 font-sans tracking-tight">Trending in the marketplace</h2>
      <p class="text-[#9CA3AF] text-sm font-sans">Install in one click. Try it free first.</p>
    </div>
    <a class="text-[#c0f500] text-sm font-medium hover:underline flex items-center gap-1 group no-underline" href="/marketplace">
      View all listings <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
    </a>
  </div>

  <!-- Type Tabs -->
  <div class="flex flex-wrap items-center gap-2.5 mb-8" role="tablist">
    {tabs.map((t, i) => (
      <button
        class={`mkt-tab px-4 py-1.5 text-xs font-mono rounded-full transition-all cursor-pointer ${
          i === 0
            ? 'bg-[#c0f500] text-[#050508] font-bold shadow-[0_0_12px_rgba(192,245,0,0.3)]'
            : 'bg-transparent text-[#9CA3AF] border border-white/10 hover:border-white/20 hover:text-white'
        }`}
        data-filter={t.toLowerCase()}
      >
        {t}
      </button>
    ))}
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="mktGrid">
    {itemsToRender.map(item => (
      <div class="mkt-card cyber-card bg-[#13131F] border border-white/5 hover:border-[#c0f500] rounded-xl p-5 relative overflow-hidden flex flex-col min-h-[190px] group cursor-pointer transition-all duration-300 hover:-translate-y-1" data-type={item.type}>
        <div class="scan-line absolute left-0 right-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-[#c0f500] to-transparent opacity-0 z-10"></div>
        <div class="flex justify-between items-start mb-4">
          <div class="w-10 h-10 rounded-lg bg-[#131317] flex items-center justify-center border border-white/5">
            <span class="material-symbols-outlined text-[#c0f500] text-xl">{item.icon}</span>
          </div>
          <div class="font-mono text-[10px] uppercase bg-white/5 px-2 py-1 rounded text-white tracking-wider border border-white/5">
            {item.pricing}
          </div>
        </div>
        <div class="mt-auto">
          <h3 class="text-base font-semibold text-white mb-2 font-sans">{item.title}</h3>
          <div class="flex justify-between items-end">
            <div class="flex items-center gap-2">
              <span class="text-[#c0f500] text-xs flex items-center font-medium font-mono">
                <span class="material-symbols-outlined text-sm mr-0.5" style="font-variation-settings: 'FILL' 1;">star</span> {item.rating}
              </span>
              <span class="text-[#4B5563] text-xs font-mono">{item.uses} uses</span>
            </div>
            <a href={`/marketplace/${item.slug}`} class="bg-[#c0f500] text-[#050508] rounded-full px-3 py-1 text-xs font-medium font-sans flex items-center gap-1 group-hover:shadow-[0_0_15px_rgba(192,245,0,0.4)] transition-all no-underline">
              Try <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
(() => {
  function initMktTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.mkt-tab');
    const cards = document.querySelectorAll<HTMLElement>('.mkt-card');
    if (!tabs.length || !cards.length) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.className = 'mkt-tab px-4 py-1.5 text-xs font-mono rounded-full transition-all cursor-pointer bg-transparent text-[#9CA3AF] border border-white/10 hover:border-white/20 hover:text-white';
        });
        tab.className = 'mkt-tab px-4 py-1.5 text-xs font-mono rounded-full transition-all cursor-pointer bg-[#c0f500] text-[#050508] font-bold shadow-[0_0_12px_rgba(192,245,0,0.3)]';

        const filter = (tab.dataset.filter || 'all').toLowerCase();
        cards.forEach(card => {
          const type = (card.dataset.type || '').toLowerCase();
          const show = filter === 'all' || type.includes(filter) || (filter === 'ai os' && type.includes('ai-os'));
          card.style.display = show ? 'flex' : 'none';
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initMktTabs);
  initMktTabs();
})();
</script>

<style>
  .mkt-card:hover .scan-line {
    animation: scan 1.5s ease-in-out infinite;
  }
  @keyframes scan {
    0% { top: 0; opacity: 0; }
    30% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }
</style>
