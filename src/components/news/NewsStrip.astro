---
/**
 * NewsStrip.astro — Today in Automation News Feed
 * Source: Google Stitch Master Page Specification (SCREEN_8)
 */
import { getCollection, type CollectionEntry } from 'astro:content';

type News = CollectionEntry<'news'>;

const all = await getCollection('news').catch(() => [] as News[]);
const top = all
  .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime())
  .slice(0, 3);

const defaultPosts = [
  {
    kind: 'launch',
    kindBadge: '🚀 LAUNCH',
    time: '22d ago',
    title: 'Claude Sonnet 5 wiki entry published with full benchmark breakdown',
    excerpt: 'Reference entry covers the Sonnet 5 release across latency, eval performance, tool use, and pricing — plus comparison against Sonnet 4.5 and Opus 4.',
    url: '/news/claude-sonnet-5-breakdown'
  },
  {
    kind: 'deep-dive',
    kindBadge: '📊 DEEP DIVE',
    time: '23d ago',
    title: 'Agentic Frameworks: CrewAI vs AutoGen Performance Analysis',
    excerpt: 'Comprehensive breakdown of multi-agent orchestration frameworks focusing on memory management, token efficiency, and error recovery rates in complex workflows.',
    url: '/news/crewai-vs-autogen'
  }
];

function relTime(iso: string) {
  const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
  if (mins < 60) return `${Math.max(1, mins)}m ago`;
  const h = Math.round(mins / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.round(h / 24)}d ago`;
}

const postsToRender = top.length > 0 ? top.map(p => ({
  kind: p.data.kind,
  kindBadge: p.data.kind === 'launch' ? '🚀 LAUNCH' : p.data.kind === 'benchmark' ? '⚡ BENCHMARK' : '📊 DEEP DIVE',
  time: relTime(p.data.published),
  title: p.data.title,
  excerpt: p.data.excerpt || '',
  url: `/news/${p.id}`
})) : defaultPosts;
---

<section class="max-w-[1280px] mx-auto px-6 py-16 relative z-10" id="news">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
    <div>
      <h2 class="text-3xl font-bold text-white mb-2 font-sans tracking-tight">Today in automation</h2>
      <p class="text-sm text-[#9CA3AF] font-sans">Launches, deep dives, and benchmarks — updated daily.</p>
    </div>
    <a class="text-sm text-[#7B61FF] font-medium hover:text-[#c0f500] transition-colors no-underline" href="/news">All news →</a>
  </div>

  <div class="flex flex-col gap-4">
    {postsToRender.map(post => (
      <a href={post.url} class="bg-[#13131F] border border-white/5 rounded-xl p-5 border-l-4 border-l-[#a8d700] hover:-translate-y-[2px] hover:border-[#a8d700] hover:shadow-[0_0_20px_rgba(168,215,0,0.25)] transition-all duration-300 cursor-pointer no-underline group block">
        <div class="flex items-center gap-3 mb-3">
          <span class="font-mono text-[10px] bg-[#a8d700]/10 text-[#a8d700] px-2 py-0.5 rounded uppercase font-bold tracking-wider">{post.kindBadge}</span>
          <span class="font-mono text-xs text-[#4B5563]">{post.time}</span>
        </div>
        <h3 class="text-base font-semibold text-white mb-2 font-sans group-hover:text-[#c0f500] transition-colors">{post.title}</h3>
        <p class="text-sm text-[#9CA3AF] font-sans leading-relaxed">{post.excerpt}</p>
      </a>
    ))}
  </div>
</section>
