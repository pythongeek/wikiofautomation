---
/**
 * WikiSpotlight.astro — From the Wiki (Encyclopedia Showcase)
 * Source: Google Stitch Master Page Specification (SCREEN_10)
 */
import { getCollection, type CollectionEntry } from 'astro:content';

type Wiki = CollectionEntry<'wiki'>;

const all = await getCollection('wiki').catch(() => [] as Wiki[]);
const sorted = all.sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime());
const top = sorted.slice(0, 6);

const defaultEntries = [
  {
    category: 'frameworks',
    title: 'n8n',
    summary: 'Fair-code workflow automation that combines no-code flexibility with code extensibility and native AI agent support.',
    url: '/wiki/frameworks/n8n',
    glowClass: 'hover:border-[#7B61FF] hover:shadow-[0_0_20px_rgba(123,97,255,0.2)] text-[#7B61FF]'
  },
  {
    category: 'protocols',
    title: 'Model Context Protocol (MCP)',
    summary: 'The open standard created by Anthropic that lets AI models securely connect to local tools, databases, and live APIs.',
    url: '/wiki/protocols/model-context-protocol',
    glowClass: 'hover:border-[#00E5FF] hover:shadow-[0_0_20px_rgba(0,229,255,0.2)] text-[#00E5FF]'
  }
];

const entriesToRender = top.length > 0 ? top.map((e, idx) => ({
  category: e.data.category,
  title: e.data.title,
  summary: e.data.summary || '',
  url: `/wiki/${e.data.category}/${e.id}`,
  glowClass: idx % 2 === 0
    ? 'hover:border-[#7B61FF] hover:shadow-[0_0_20px_rgba(123,97,255,0.2)] text-[#7B61FF]'
    : 'hover:border-[#00E5FF] hover:shadow-[0_0_20px_rgba(0,229,255,0.2)] text-[#00E5FF]'
})) : defaultEntries;

const categories = ['ALL', 'Agents', 'Frameworks', 'Protocols', 'Models', 'Companies', 'Concepts'];
---

<section class="py-20 relative overflow-hidden bg-[#1b1b1f]/60 border-y border-white/5" id="wiki">
  <div class="max-w-[1280px] mx-auto px-6 relative z-10">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
      <div>
        <h2 class="text-3xl font-bold text-white mb-2 font-sans tracking-tight">From the wiki</h2>
        <p class="text-sm text-[#9CA3AF] font-sans">{all.length || defaultEntries.length} reference entries — neutral, sourced, updated.</p>
      </div>
      <a class="text-sm text-[#00E5FF] hover:underline flex items-center gap-1 group no-underline transition-all" href="/wiki">
        Open full index
        <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>

    <!-- Category Pills -->
    <div class="flex flex-wrap gap-2.5 mb-8" role="tablist">
      {categories.map((c, i) => (
        <button
          class={`wiki-tab rounded-full px-4 py-1 text-xs font-mono tracking-wide uppercase transition-all cursor-pointer ${
            i === 0
              ? 'bg-[#c0f500] text-[#050508] font-bold shadow-[0_0_10px_rgba(200,255,0,0.2)]'
              : 'border border-white/10 text-[#9CA3AF] hover:border-[#c0f500] hover:text-[#c0f500]'
          }`}
          data-cat={c.toLowerCase()}
        >
          {c}
        </button>
      ))}
    </div>

    <!-- Entry Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="wikiGrid">
      {entriesToRender.map(entry => (
        <a href={entry.url} class={`glass-card bg-[#131317]/80 backdrop-blur-xl border border-white/5 rounded-2xl p-6 flex flex-col min-h-[260px] group cursor-pointer transition-all duration-300 no-underline ${entry.glowClass}`} data-cat={entry.category}>
          <div class="mb-4">
            <span class="text-xs font-mono font-bold tracking-[0.1em] uppercase opacity-90">{entry.category}</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-3 font-sans">{entry.title}</h3>
          <p class="text-sm text-[#9CA3AF] mb-6 flex-grow leading-relaxed font-sans">
            {entry.summary}
          </p>
          <div class="flex items-center text-sm font-medium mt-auto transition-colors font-sans">
            Read entry
            <span class="material-symbols-outlined text-base ml-1 group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
(() => {
  function initWikiTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.wiki-tab');
    const cards = document.querySelectorAll<HTMLElement>('.glass-card');
    if (!tabs.length || !cards.length) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.className = 'wiki-tab rounded-full px-4 py-1 text-xs font-mono tracking-wide uppercase transition-all cursor-pointer border border-white/10 text-[#9CA3AF] hover:border-[#c0f500] hover:text-[#c0f500]';
        });
        tab.className = 'wiki-tab rounded-full px-4 py-1 text-xs font-mono tracking-wide uppercase transition-all cursor-pointer bg-[#c0f500] text-[#050508] font-bold shadow-[0_0_10px_rgba(200,255,0,0.2)]';

        const cat = (tab.dataset.cat || 'all').toLowerCase();
        cards.forEach(card => {
          const itemCat = (card.dataset.cat || '').toLowerCase();
          const show = cat === 'all' || itemCat.includes(cat);
          card.style.display = show ? 'flex' : 'none';
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initWikiTabs);
  initWikiTabs();
})();
</script>
