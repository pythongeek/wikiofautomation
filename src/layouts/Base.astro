---
/**
 * Base.astro — Master Layout with Tailwind Engine & Stitch Cyber-Industrial Design System
 * Source: Google Stitch Master Page Specification
 */
import '../styles/global.css';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import ObsidianBg from '~/components/common/ObsidianBg.astro';
import { CommandPalette } from '~/components/utility/CommandPalette';
import { AdaWidget } from '~/components/ada/AdaWidget';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const SITE = 'https://wikiofautomation.com';
const DEFAULT_TITLE = 'wiki of automation — the encyclopedia of automation';
const DEFAULT_DESC = 'The encyclopedia of automation — understand it, find it, ship it. AI agents, n8n workflows, MCP, and every protocol making automation real.';
const OG_IMAGE = `${SITE}/assets/og/og-image.png`;

const {
  title,
  description = DEFAULT_DESC,
  image = OG_IMAGE,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE).toString();
const fullTitle = title ? `${title} — wiki of automation` : DEFAULT_TITLE;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <meta name="theme-color" content="#050508">

  <!-- OG / Twitter -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>
  <meta property="og:site_name" content="wiki of automation">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>

  <link rel="icon" type="image/svg+xml" href="/assets/img/logo.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Fonts: Geist (headline & body), JetBrains Mono (code/stats), Material Symbols -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet">

  <!-- Tailwind CSS Engine & Stitch Cyber-Industrial Theme Config -->
  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script is:inline id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "outline-variant": "#434933",
            "on-error": "#690005",
            "surface-variant": "#353439",
            "on-primary-fixed-variant": "#3b4d00",
            "on-primary-container": "#546d00",
            "background": "#050508",
            "tertiary-fixed-dim": "#c9bfff",
            "secondary": "#bdf4ff",
            "inverse-surface": "#e5e1e7",
            "on-primary": "#273500",
            "on-secondary-container": "#00616d",
            "primary-fixed": "#c0f500",
            "surface-container-high": "#2a292e",
            "secondary-fixed": "#9cf0ff",
            "surface-container-lowest": "#0e0e12",
            "on-surface": "#e5e1e7",
            "on-secondary": "#00363d",
            "error": "#ffb4ab",
            "surface": "#131317",
            "on-tertiary": "#2e009c",
            "surface-tint": "#a8d700",
            "tertiary": "#ffffff",
            "on-error-container": "#ffdad6",
            "primary-container": "#c0f500",
            "primary-fixed-dim": "#a8d700",
            "tertiary-container": "#e5deff",
            "on-secondary-fixed": "#001f24",
            "on-secondary-fixed-variant": "#004f58",
            "outline": "#8e9479",
            "primary": "#ffffff",
            "surface-bright": "#39393d",
            "on-primary-fixed": "#161f00",
            "on-surface-variant": "#c4caac",
            "on-tertiary-fixed": "#1a0063",
            "on-background": "#e5e1e7",
            "secondary-fixed-dim": "#00daf3",
            "tertiary-fixed": "#e5deff",
            "on-tertiary-container": "#6346e6",
            "inverse-primary": "#4f6600",
            "inverse-on-surface": "#303034",
            "surface-container-low": "#1b1b1f",
            "surface-container-highest": "#353439",
            "surface-dim": "#131317",
            "secondary-container": "#00e3fd",
            "surface-container": "#1f1f23",
            "error-container": "#93000a",
            "on-tertiary-fixed-variant": "#441cc8"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          spacing: {
            "xl": "80px",
            "lg": "40px",
            "sm": "16px",
            "md": "24px",
            "base": "4px",
            "xs": "8px",
            "gutter": "24px",
            "container-max": "1280px"
          },
          fontFamily: {
            "stat-lg": ["JetBrains Mono", "monospace"],
            "hero-mobile": ["Geist", "sans-serif"],
            "technical-sm": ["JetBrains Mono", "monospace"],
            "h3": ["Geist", "sans-serif"],
            "h2": ["Geist", "sans-serif"],
            "body": ["Geist", "sans-serif"],
            "hero": ["Geist", "sans-serif"]
          },
          fontSize: {
            "stat-lg": ["24px", { lineHeight: "1", letterSpacing: "-0.01em", fontWeight: "700" }],
            "hero-mobile": ["40px", { lineHeight: "1.2", fontWeight: "700" }],
            "technical-sm": ["12px", { lineHeight: "1.4", fontWeight: "400" }],
            "h3": ["18px", { lineHeight: "1.5", fontWeight: "600" }],
            "h2": ["36px", { lineHeight: "1.3", fontWeight: "600" }],
            "body": ["14px", { lineHeight: "1.6", fontWeight: "400" }],
            "hero": ["64px", { lineHeight: "1.1", letterSpacing: "-0.02em", fontWeight: "700" }]
          }
        }
      }
    };
  </script>

  <ClientRouter />
</head>
<body class="bg-[#050508] text-[#e5e1e7] font-body min-h-screen flex flex-col antialiased selection:bg-[#c0f500] selection:text-[#161f00] relative">
  <ObsidianBg />
  <Header />
  <main class="flex-grow">
    <slot />
  </main>
  <Footer />
  <AdaWidget client:load />
  <CommandPalette client:load />
</body>
</html>
