---
// src/pages/chat.astro — Minimax AI Live RAG Chatroom
import Base from '../layouts/Base.astro';
import ChatInterface from '../components/ChatInterface';

export const prerender = true;
---

<Base title="Minimax AI Assistant | Wiki of Automation">
  <main class="min-h-screen bg-[#0E0E12] text-[#E5E1E7] p-4 md:p-8 font-sans">
    <div class="max-w-4xl mx-auto space-y-6">
      
      {/* Header */}
      <div class="text-center space-y-2 py-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C0F500]/10 border border-[#C0F500]/20 text-[#C0F500] text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-[#C0F500] animate-pulse"></span>
          Minimax M3 + Vector RAG Engine Live
        </div>
        <h1 class="text-3xl md:text-4xl font-bold font-mono tracking-tight text-white">
          WikiOfAutomation AI Assistant
        </h1>
        <p class="text-sm text-[#8B8FA3] max-w-xl mx-auto">
          Ask questions about n8n workflows, Claude MCP servers, AutoNode licenses, and platform documentation grounded in real-time vector search.
        </p>
      </div>

      {/* Interactive Chat Widget */}
      <div class="shadow-2xl rounded-2xl">
        <ChatInterface client:only="react" />
      </div>

    </div>
  </main>
</Base>
