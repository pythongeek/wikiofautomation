---
/**
 * /community/forum — Community Forum Index Page
 */
import Base from '~/layouts/Base.astro';
import { ForumIndex } from '~/components/community/ForumIndex';

export const prerender = true;
---

<Base
  title="Community Forum — AI Workflows & MCP Discussions | Wiki of Automation"
  description="Join open builder discussions on AI agent swarms, n8n workflows, Model Context Protocol servers, and prompt engineering."
>
  <div class="pt-20 min-h-screen bg-[#050508] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#c0f500]/10 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>
    <ForumIndex client:load />
  </div>
</Base>
