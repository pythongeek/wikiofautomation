---
/**
 * /community/leaderboard — Builder Leaderboard Page
 */
import Base from '~/layouts/Base.astro';
import { Leaderboard } from '~/components/community/Leaderboard';

export const prerender = true;
---

<Base
  title="Builder Leaderboard — Top Creators & Standings | Wiki of Automation"
  description="Top creators this month by installs, revenue, and community rating across verified AI workflows, agents, and MCP tools."
>
  <div class="pt-20 min-h-screen bg-[#050508] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#00e3fd]/10 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>
    <Leaderboard client:load />
  </div>
</Base>
