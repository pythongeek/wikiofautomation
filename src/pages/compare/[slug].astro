---
/**
 * /compare/[slug] — Tool Comparison Page
 */
import Base from '~/layouts/Base.astro';
import { CompareTool } from '~/components/utility/CompareTool';

export function getStaticPaths() {
  return [
    { params: { slug: 'n8n-vs-make' } },
    { params: { slug: 'n8n-vs-zapier' } },
    { params: { slug: 'claude-vs-chatgpt' } },
    { params: { slug: 'langgraph-vs-autogen' } },
  ];
}

const { slug } = Astro.params;

export const prerender = true;
---

<Base
  title={`Compare ${slug?.replace('-vs-', ' vs ') || 'Tools'} — Decision Matrix | Wiki of Automation`}
  description="Side-by-side comparison matrix covering pricing, hosting, AI-native nodes, workflow logic, open source, and WOA marketplace listings."
>
  <div class="pt-20 min-h-screen bg-[#050508] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#c0f500]/10 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>
    <CompareTool slug={slug} client:load />
  </div>
</Base>
