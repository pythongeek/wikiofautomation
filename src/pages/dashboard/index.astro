---
/**
 * /dashboard — Creator Dashboard Page
 */
import Base from '~/layouts/Base.astro';
import { CreatorDashboard } from '~/components/dashboard/CreatorDashboard';

const tab = Astro.url.searchParams.get('tab') || 'overview';

export const prerender = true;
---

<Base
  title="Creator Dashboard — Wiki of Automation"
  description="Manage published AI tools, track monthly revenue, view analytics, and publish new n8n workflows or agents."
>
  <div class="pt-16 min-h-screen bg-[#050508]">
    <CreatorDashboard initialTab={tab} client:load />
  </div>
</Base>
