---
/**
 * /dashboard/settings — User Settings Page
 */
import Base from '~/layouts/Base.astro';
import { UserSettings } from '~/components/dashboard/UserSettings';

export const prerender = true;
---

<Base
  title="Account Settings — Wiki of Automation"
  description="Manage profile information, email and in-app notifications, billing, and API developer keys."
>
  <div class="pt-20 min-h-screen bg-[#050508] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#c0f500]/10 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>
    <UserSettings client:load />
  </div>
</Base>
