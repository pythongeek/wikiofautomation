---
/**
 * /marketplace/[type] — Type-filtered listing grid supporting all 9 verticals
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';

export async function getStaticPaths() {
  const VALID = [
    'agent',
    'workflow',
    'enterprise-workflow',
    'plugin',
    'notebook-kit',
    'turnkey-game',
    'ai-os',
    'app',
    'prompt',
  ] as const;

  return VALID.map((t: typeof VALID[number]) => ({
    params: { type: t === 'ai-os' ? 'ai-os' : `${t}s` },
  }));
}

type Listing = CollectionEntry<'marketplace'>;
const { type } = Astro.params;
const all = await getCollection('marketplace', (e: Listing) => e.data.status === 'live');
const filtered: Listing[] = all.filter((e: Listing) => {
  const t = e.data.type;
  if (type === 'ai-os') return t === 'ai-os';
  return `${t}s` === type;
});
filtered.sort((a: Listing, b: Listing) => b.data.uses - a.data.uses);

const typeTitles: Record<string, string> = {
  agents: 'Autonomous AI Agents',
  workflows: 'n8n & Automation Workflows',
  'enterprise-workflows': '150+ Node Enterprise Mega-Workflows',
  plugins: 'WordPress, MCP & DirectRelay Plugins',
  'notebook-kits': 'Kaggle & Colab GPU Relay Kits',
  'turnkey-games': 'Turnkey Arcade & iGaming Platforms',
  'ai-os': 'AI OS Stacks',
  apps: 'Full-Stack Automation Apps',
  prompts: 'System Prompts & Specs',
};
---

<Base
  title={`${typeTitles[type ?? ''] ?? type} — Marketplace | Wiki of Automation`}
  description={`${typeTitles[type ?? ''] ?? type} listings in the Neural Discovery Marketplace.`}
>
  <div class="pt-28 pb-20 max-w-[1440px] mx-auto px-6 relative z-10">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-mono text-[#9ca3af] uppercase tracking-wider mb-6">
      <a href="/marketplace" class="text-[#c0f500] hover:underline no-underline">MARKETPLACE</a>
      <span>/</span>
      <span class="text-white font-bold">{type}</span>
    </div>

    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-10 border-b border-white/10 pb-6">
      <div>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
          {typeTitles[type ?? ''] ?? type}{' '}
          <span class="text-sm font-mono font-normal text-[#9ca3af]">({filtered.length} listings)</span>
        </h1>
        <p class="text-sm sm:text-base text-[#9ca3af] mt-1">
          Verified {type} nodes and production packages ready for immediate deployment.
        </p>
      </div>
      <a
        href="/marketplace/publish"
        class="bg-[#c0f500] text-[#161f00] text-xs font-mono font-bold px-5 py-2.5 rounded-full hover:shadow-[0_0_20px_rgba(192,245,0,0.4)] transition-all no-underline"
      >
        + Publish Listing
      </a>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {filtered.map((item) => {
        const typeParam = item.data.type === 'ai-os' ? 'ai-os' : `${item.data.type}s`;
        return (
          <a
            href={`/marketplace/${typeParam}/${item.id}`}
            class="group bg-[#131317] border border-white/10 hover:border-[#c0f500] rounded-2xl p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(192,245,0,0.15)] flex flex-col justify-between no-underline"
          >
            <div>
              {item.data.hero_image && (
                <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-[#050508] border border-white/10 mb-3.5 group-hover:border-[#00e3fd]/40 transition-colors">
                  <img
                    src={item.data.hero_image}
                    alt={item.data.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              )}
              <div class="flex items-center justify-between mb-3">
                <div class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-lg">
                  {item.data.icon ?? '⚡'}
                </div>
                <div class="flex items-center gap-1.5">
                  {item.data.node_count && (
                    <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-white/5 text-[#c4caac] border border-white/10">
                      {item.data.node_count} nodes
                    </span>
                  )}
                  <span
                    class={`text-[10px] font-mono font-bold px-2.5 py-1 rounded-full uppercase ${
                      item.data.pricing === 'free'
                        ? 'bg-[#c0f500]/10 text-[#c0f500] border border-[#c0f500]/20'
                        : item.data.pricing === 'paid'
                        ? 'bg-[#00e3fd]/10 text-[#00e3fd] border border-[#00e3fd]/20'
                        : 'bg-[#7b61ff]/10 text-[#7b61ff] border border-[#7b61ff]/20'
                    }`}
                  >
                    {item.data.price_label || item.data.pricing}
                  </span>
                </div>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-[#c0f500] transition-colors mb-2">
                {item.data.title}
              </h3>
              <p class="text-xs text-[#9ca3af] line-clamp-2 leading-relaxed mb-4">{item.data.summary ?? ''}</p>
            </div>

            <div>
              <div class="flex items-center justify-between text-xs font-mono text-[#9ca3af] mb-3">
                <span class="text-[#c0f500]">★ {item.data.rating.toFixed(1)}</span>
                <span>{item.data.uses.toLocaleString()} uses</span>
              </div>
              <div class="flex items-center justify-between border-t border-white/5 pt-3 text-xs font-mono text-[#9ca3af]">
                <span class="text-[#00e3fd] font-semibold">{item.data.type}</span>
                <span>by {item.data.original_author}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Base>
