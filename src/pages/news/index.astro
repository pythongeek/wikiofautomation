---
/**
 * /news — News Index Hub Page
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { NewsIndex as NewsIndexReact } from '~/components/news/NewsIndex';

export const prerender = true;

const newsEntries = await getCollection('news');
const formattedArticles = newsEntries.map((e) => ({
  slug: e.id,
  title: e.data.title,
  category: e.data.category || 'LAUNCH',
  kind: e.data.kind,
  published: e.data.published,
  excerpt: e.data.excerpt || '',
  hero_image: e.data.hero_image || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=800&auto=format&fit=crop',
  author: e.data.author || 'Ada',
  author_avatar: e.data.author_avatar || 'https://api.dicebear.com/7.x/bottts/svg?seed=ada',
  read_time: e.data.read_time || '4 min read',
  featured: e.data.featured || false,
}));
---

<Base
  title="Today in Automation — News & Benchmarks | Wiki of Automation"
  description="Daily launches, deep dives, benchmarks, and tools across AI agents, n8n workflows, and developer operating systems."
>
  <div class="pt-20 min-h-screen bg-[#050508] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#7b61ff]/15 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>
    <NewsIndexReact client:load articles={formattedArticles} />
  </div>
</Base>
