---
/**
 * /seo-tools — SEO & AEO Tools Hub Page
 */
import Base from '~/layouts/Base.astro';
import { SeoToolsHub } from '~/components/seo-tools/SeoToolsHub';

export const prerender = true;
---

<Base
  title="SEO & AEO Tools — Free AI Search Optimization | Wiki of Automation"
  description="Free SEO & AEO tools built for the AI-first search era. Schema Gap Finder, AEO Analyzer, Keyword Clusters, Content Brief Generator, and GEO Optimizer."
>
  <div class="pt-20 min-h-screen bg-[#050508] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#00e3fd]/10 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>
    <SeoToolsHub client:load />
  </div>
</Base>
