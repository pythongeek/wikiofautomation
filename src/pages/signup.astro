---
/**
 * /signup — Sign Up Page for WikiOfAutomation.com
 */
import Base from '~/layouts/Base.astro';
import { SignUpForm } from '~/components/auth/SignUpForm';

export const prerender = true;
---

<Base
  title="Sign Up — Wiki of Automation"
  description="Create your free WikiOfAutomation account to publish tools, contribute to the wiki, and join the automation community."
>
  <div class="min-h-screen bg-[#050508] text-white flex flex-col justify-between relative overflow-hidden">
    <!-- Faint Violet Radial Gradient Background -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#7b61ff]/20 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>

    <!-- Minimal Navbar: Logo only -->
    <header class="w-full h-20 px-6 sm:px-12 flex items-center justify-between z-20">
      <a href="/" class="flex items-center gap-3 group no-underline">
        <div class="w-9 h-9 rounded-xl bg-[#c0f500] text-[#161f00] flex items-center justify-center font-bold text-lg shadow-[0_0_20px_rgba(192,245,0,0.4)] group-hover:scale-105 transition-transform">
          ⚡
        </div>
        <span class="font-bold text-lg text-white tracking-tight font-sans">
          Wiki <span class="text-[#c0f500]">of Automation</span>
        </span>
      </a>
    </header>

    <!-- Main Container: Centered Card -->
    <main class="flex-1 flex items-center justify-center px-4 py-12 z-10">
      <SignUpForm client:load signInUrl="/signin" termsUrl="/terms" privacyUrl="/privacy" />
    </main>

    <!-- Minimal Footer -->
    <footer class="w-full py-6 text-center text-xs font-mono text-[#9ca3af]/60 z-20">
      © 2026 WikiOfAutomation.com · All rights reserved.
    </footer>
  </div>
</Base>
