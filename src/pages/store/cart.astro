---
/**
 * /store/cart — Shopping Cart Page
 */
import Base from '~/layouts/Base.astro';
import { CartPage as CartPageReact } from '~/components/store/CartPage';

export const prerender = true;
---

<Base
  title="Shopping Cart — Wiki of Automation"
  description="Review your selected AI agents, n8n workflows, and developer OS tools in your WikiOfAutomation shopping cart."
>
  <div class="pt-20 min-h-screen bg-[#050508] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#7b61ff]/15 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>
    <CartPageReact client:load />
  </div>
</Base>
