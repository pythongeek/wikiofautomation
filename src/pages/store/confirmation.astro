---
/**
 * /store/confirmation — Order Confirmation Page
 */
import Base from '~/layouts/Base.astro';
import { ConfirmationPage as ConfirmationPageReact } from '~/components/store/ConfirmationPage';

export const prerender = true;
---

<Base
  title="Order Confirmation — Wiki of Automation"
  description="Your WikiOfAutomation purchase is confirmed. Download your tools and view installation instructions."
>
  <div class="pt-20 min-h-screen bg-[#050508] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#c0f500]/15 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>
    <ConfirmationPageReact client:load />
  </div>
</Base>
