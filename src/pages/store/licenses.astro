---
/**
 * /store/licenses — License Management Page
 */
import Base from '~/layouts/Base.astro';
import { LicenseManagement } from '~/components/store/LicenseManagement';

export const prerender = true;
---

<Base
  title="License Management — Wiki of Automation"
  description="Manage purchased workflow licenses, download deployment packages (.zip/.json), manage team seats, and copy API keys."
>
  <div class="pt-20 min-h-screen bg-[#050508] relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#00e3fd]/10 via-[#050508]/80 to-[#050508] pointer-events-none -z-10"></div>
    <LicenseManagement client:load />
  </div>
</Base>
