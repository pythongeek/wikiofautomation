---
/**
 * /wiki/[category]/[slug] — single wiki entry detail page with Cyber-Industrial styling
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map((entry: CollectionEntry<'wiki'>) => ({
    params: { category: entry.data.category, slug: entry.slug },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'wiki'>; }
const { entry } = Astro.props;
const { Content } = await entry.render();

const ib = entry.data.infobox ?? {};
const ibRows = Object.entries(ib).filter(([, v]) => v !== undefined && v !== '');
---

<Base
  title={entry.data.title}
  description={entry.data.summary ?? `${entry.data.title} — wiki of automation`}
>
  <article class="relative min-h-[90vh] pt-28 pb-20 px-6 max-w-[1280px] mx-auto">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-mono text-[#9ca3af] uppercase tracking-wider mb-6">
      <a href="/wiki" class="text-[#c0f500] hover:underline no-underline">WIKI INDEX</a>
      <span>/</span>
      <a href={`/wiki/${entry.data.category}`} class="text-[#00e3fd] hover:underline no-underline">{entry.data.category}</a>
      <span>/</span>
      <span class="text-white font-bold">{entry.data.title}</span>
    </div>

    <!-- Header -->
    <header class="mb-10 border-b border-white/10 pb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs font-mono uppercase px-3 py-1 rounded-full bg-[#c0f500]/10 text-[#c0f500] border border-[#c0f500]/20 font-semibold">
          {entry.data.category}
        </span>
        <span class="text-xs font-mono text-[#9ca3af]">
          Updated: {entry.data.updated}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4 leading-tight">
        {entry.data.title}
      </h1>

      {entry.data.bangla_title && (
        <p class="text-lg font-mono text-[#c0f500] mb-3">{entry.data.bangla_title}</p>
      )}

      {entry.data.summary && (
        <p class="text-base sm:text-lg text-[#9ca3af] max-w-3xl leading-relaxed">
          {entry.data.summary}
        </p>
      )}
    </header>

    <!-- Grid Layout: Main Article + Infobox Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <main class="lg:col-span-8 bg-[#131317]/60 border border-white/10 rounded-2xl p-6 sm:p-10 backdrop-blur-xl prose prose-invert max-w-none">
        <Content />
      </main>

      <aside class="lg:col-span-4 space-y-6 sticky top-24">
        <!-- Infobox Panel -->
        <div class="bg-[#131317] border border-white/10 rounded-2xl overflow-hidden backdrop-blur-xl">
          <div class="bg-white/5 border-b border-white/10 px-5 py-3 font-mono text-xs font-semibold text-[#c0f500] uppercase tracking-wider flex items-center justify-between">
            <span>SPECIFICATION INFOBOX</span>
            <span class="material-symbols-outlined text-base">info</span>
          </div>

          <dl class="divide-y divide-white/5">
            {ibRows.map(([k, v]) => (
              <div class="grid grid-cols-12 gap-2 px-5 py-3 text-xs">
                <dt class="col-span-5 font-mono text-[#9ca3af] capitalize">{k.replace(/_/g, ' ')}</dt>
                <dd class="col-span-7 text-white font-medium break-all">
                  {k === 'repo' || k === 'site' ? (
                    <a href={String(v)} target="_blank" rel="noopener" class="text-[#00e3fd] hover:underline flex items-center gap-1">
                      {String(v)}
                      <span class="material-symbols-outlined text-xs">open_in_new</span>
                    </a>
                  ) : (
                    String(v)
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- Sources Panel -->
        {entry.data.sources.length > 0 && (
          <div class="bg-[#131317] border border-white/10 rounded-2xl overflow-hidden backdrop-blur-xl">
            <div class="bg-white/5 border-b border-white/10 px-5 py-3 font-mono text-xs font-semibold text-[#00e3fd] uppercase tracking-wider flex items-center justify-between">
              <span>SOURCES & CITATIONS</span>
              <span class="material-symbols-outlined text-base">link</span>
            </div>

            <ul class="divide-y divide-white/5 px-5 py-2">
              {entry.data.sources.map((s: { title: string; url: string }) => (
                <li class="py-2.5">
                  <a href={s.url} target="_blank" rel="noopener" class="text-xs text-[#00e3fd] hover:underline flex items-center justify-between gap-2">
                    <span class="truncate">{s.title}</span>
                    <span class="material-symbols-outlined text-xs shrink-0">open_in_new</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>
</Base>
